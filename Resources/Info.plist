<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>            <string>Clepsydra</string>
    <key>CFBundleDisplayName</key>     <string>Clepsydra</string>
    <key>CFBundleExecutable</key>      <string>Clepsydra</string>
    <key>CFBundleIdentifier</key>      <string>com.ilyapesterev.clepsydra</string>
    <key>CFBundleIconFile</key>        <string>Clepsydra</string>
    <key>CFBundlePackageType</key>     <string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.1</string>
    <!-- Номер сборки ставит build.sh, см. docs/development.md. -->
    <key>CFBundleVersion</key>         <string>0</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>NSHumanReadableCopyright</key>   <string>© Илья Пестерев</string>
    <key>LSMinimumSystemVersion</key>  <string>14.0</string>
    <key>LSUIElement</key>             <true/>
    <key>NSHighResolutionCapable</key> <true/>
    <key>NSSupportsAutomaticTermination</key><false/>
    <key>NSSupportsSuddenTermination</key><false/>
    <!-- Обновление ставится на месте, см. docs/adr/0010-update-installs-itself.md. -->
    <!-- Фид установщика: тот же постоянный адрес, что и у фида приложения. -->
    <key>SUFeedURL</key>               <string>https://github.com/ilya-pesterev/clepsydra/releases/latest/download/updates.xml</string>
    <!-- Открытая половина ключа EdDSA; закрытая живёт в связке ключей автора.
         Печатает её ./Tools/sign-update.swift --public. Без неё установщик не
         заводится, и «Обновить» открывает страницу релиза, как раньше. -->
    <key>SUPublicEDKey</key>           <string>UComlqa6VNTVOXrmepoK446EBNlZK8bEcwH4ZVLDSDg=</string>
    <!-- Проверяет обновления сама Clepsydra: раз в сутки и молча (ADR-0009).
         Второе расписание в лицо человеку — ровно то, чего здесь быть не должно. -->
    <key>SUEnableAutomaticChecks</key> <false/>
</dict>
</plist>
